<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>embedded</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Omega3065.RaCustomMenu</PackageId>
    <Version>0.2.0.0</Version>
    <Authors>OMEGA3065; Bankokwak</Authors>
    <IsPackable>true</IsPackable>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/OMEGA3065/RaCustomMenu/</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp" Publicize="true" Private="false" Pack="false" />
    <Reference Include="CommandSystem.Core" />
    <Reference Include="Assembly-CSharp-firstpass"/>
    <Reference Include="UnityEngine.CoreModule"/>
    <Reference Include="Mirror"/>
    <Reference Include="Mono.Security"/>
    <Reference Include="UnityEngine.PhysicsModule"/>
    <Reference Include="Pooling"/>

    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Northwood.LabAPI" Version="1.1.6.1" />
    <PackageReference Include="Lib.Harmony" Version="2.2.2" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
